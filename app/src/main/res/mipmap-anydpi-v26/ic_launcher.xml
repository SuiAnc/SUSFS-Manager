<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (API 26+). The foreground is the project logo rasterised per density and scaled
     to sit inside the 72dp safe zone of the 108dp canvas, so no mask shape clips it. The background
     is a flat colour rather than an image: the logo is mostly white, so a solid backing keeps it
     legible on every launcher. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
